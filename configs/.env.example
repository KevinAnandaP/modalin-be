PORT=8080

DB_HOST=127.0.0.1 # kalo running tanpa docker
# DB_HOST=db # kalo running pake docker
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=modalin-db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
JWT_SECRET=replace-with-a-long-random-secret
APP_ENV=development
# Comma-separated browser origins. Production requires HTTPS origins only.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated OAuth client IDs that are allowed to mint Google ID tokens.
GOOGLE_OAUTH_CLIENT_IDS=replace-with-your-google-oauth-client-id
# Optional one-time admin bootstrap. Remove after the account is created.
# BOOTSTRAP_ADMIN_EMAIL=admin@modalin.my.id
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Xendit Payment Gateway Configurations
XENDIT_SECRET_KEY=xnd_development_replace_with_your_xendit_secret_key
XENDIT_WEBHOOK_VERIFICATION_TOKEN=replace_with_your_xendit_webhook_token
XENDIT_MODE=sandbox
