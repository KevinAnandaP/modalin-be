					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.temp_token) {",
									"    pm.collectionVariables.set('tempToken', jsonData.data.temp_token);",
									"    console.log('Temp Token Google tersimpan di variable {{tempToken}}!');",
									"}",
									"if (jsonData.data && jsonData.data.login_result && jsonData.data.login_result.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.login_result.token);",
